{
  "compilerOptions": {
    "target": "es2016",
    "rootDir": "./src",
    // "target": "es6"
    // "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "*/scripts/*"]
}
